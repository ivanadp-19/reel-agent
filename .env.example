# Pexels — optional stock footage/photo search for B-roll (the agent's search_stock tool).
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: OpenAI key for generate_asset (stickers, doodles, textures as transparent PNG).
# https://platform.openai.com/api-keys — you pay per image; search_asset needs no key.
# OPENAI_API_KEY=
# REEL_IMAGE_MODEL=gpt-image-1.5

# Optional: force the WhisperX device (default: auto — cuda if torch sees a GPU, else cpu).
# REEL_DEVICE=cpu

# Optional: face-aware caption placement (local YuNet detector). 0 = always use the default position.
# REEL_FACE_AWARE=1

# Speaker diarization (who is talking): a Hugging Face READ token. Accept the terms of pyannote/speaker-diarization-3.1,
# pyannote/segmentation-3.0 and pyannote/speaker-diarization-community-1 on huggingface.co first. Without it, the
# off-mic voice is told apart by loudness alone.
# HF_TOKEN=

# Optional: Deepgram Nova-3 transcription (free credit at deepgram.com) instead
# of local WhisperX — much faster on CPU. Same cache format; falls back to
# WhisperX on any failure. REEL_STT=whisperx forces the local engine.
DEEPGRAM_API_KEY=
