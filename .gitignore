# secrets — never commit
.env

# deps / build
node_modules/
out/
build/
.venv
whisper.cpp/

# ALL user media + generated data live in public/ (clips, projects with speech
# transcripts, music, waveforms, exports) — personal, never committed
public/*
!public/.gitkeep

# pipeline temp files (the backend writes every job's input as .<job>-<id>.json in the root and removes it when the job ends)
.captions-tmp/
.*-[0-9]*.json
.props-*.json
.clips-*.json
.broll-*.json
.arrange-*.json
.trim-*.json
.upload-*

# IDE
.idea/

# local agent settings / downloaded models
.claude/settings.local.json
.models/

# reference videos for style study (copyrighted, never commit)
.refs/

# per-run secret between the backend and the MCP server; pids for npm run stop
.backend-token
.backend.pid
.dev.pid
