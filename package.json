{
  "name": "reel-agent",
  "version": "0.1.0",
  "description": "Open-source AI reels editor driven by Claude Code or Codex: cut, color, premium captions, B-roll and motion graphics.",
  "license": "Apache-2.0",
  "private": true,
  "keywords": [
    "remotion",
    "captions",
    "subtitles",
    "video",
    "whisper",
    "b-roll",
    "short-form",
    "video-editing"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "setup": "bash scripts/setup.sh",
    "editor": "vite",
    "editor:server": "node server/index.mjs",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "mcp": "node mcp/server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/cli": "4.0.380",
    "@remotion/google-fonts": "^4.0.380",
    "@remotion/install-whisper-cpp": "^4.0.380",
    "@remotion/media-parser": "^4.0.380",
    "@remotion/player": "^4.0.380",
    "@remotion/studio": "^4.0.380",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.380",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.2",
    "vite": "^5.4.21"
  },
  "type": "module"
}
